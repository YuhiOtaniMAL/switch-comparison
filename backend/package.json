{
  "name": "swifty-companion-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "tunnel": "bash -c 'set -a; source .env; set +a; concurrently -n backend,ngrok -c blue,green \"npm run dev\" \"../ngrok http --url=$NGROK_DOMAIN 3000\"'"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "concurrently": "^10.0.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
